{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "permission": {
    "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny" },
    "edit": { "*": "allow", "*.env": "deny", "*.env.*": "deny" },
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git add -f*": "deny",
      "rm -rf*": "ask",
      "printenv*": "deny",
      "env": "deny"
    }
  }
}
